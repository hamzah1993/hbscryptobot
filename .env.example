NODE_ENV=development
POSTGRES_DB=hbstrading
POSTGRES_USER=hbs
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://hbs:change_me@postgres:5432/hbstrading?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
EXCHANGE_CREDENTIALS_KEY=replace_with_base64_encoded_32_byte_key

# Global API rate limiting
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120

# Stricter authentication endpoint rate limiting
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_REGISTER_RATE_LIMIT_MAX_REQUESTS=5
AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=10

VITE_API_URL=http://localhost:3000/api

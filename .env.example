NODE_ENV=development
POSTGRES_DB=hbstrading
POSTGRES_USER=hbs
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://hbs:change_me@postgres:5432/hbstrading?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call the API (comma-separated). Defaults to FRONTEND_URL.
CORS_ORIGINS=
# Public IPv4 of the trading server; shown to users so they restrict their Binance API keys to it.
SERVER_OUTBOUND_IP=
# Admins must have two-factor authentication on to open the admin area. Only set false for local development.
ADMIN_REQUIRE_2FA=true
JWT_EXPIRES_IN=1d
EXCHANGE_CREDENTIALS_KEY=replace_with_base64_encoded_32_byte_key

# Global API rate limiting
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120

# Reverse proxies in front of the backend. Rate limits use the client IP these
# proxies forward; with the wrong value every user shares one limit. After
# deploying, sign in and open /api/health/client-ip: "ip" must be your own
# public IP. If it is not, increase this by one and redeploy.
TRUST_PROXY_HOPS=1

# Stricter authentication endpoint rate limiting
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_REGISTER_RATE_LIMIT_MAX_REQUESTS=5
AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=10

# Redis distributed lock TTLs
TESTNET_STRATEGY_SCHEDULER_LOCK_TTL_MS=30000
TESTNET_ORDER_SYNC_SCHEDULER_LOCK_TTL_MS=30000
PAPER_STRATEGY_SCHEDULER_LOCK_TTL_MS=30000
NOTIFICATION_RETENTION_SCHEDULER_LOCK_TTL_MS=300000
TESTNET_STRATEGY_EXECUTION_LOCK_TTL_MS=30000

# Binance requests: timeout per call, and how long an unfilled entry limit
# order may rest before it is cancelled so the bot can re-evaluate.
BINANCE_HTTP_TIMEOUT_MS=10000
ENTRY_LIMIT_ORDER_TIMEOUT_MS=45000
# Users / orders processed in parallel by each scheduler pass.
LIVE_STRATEGY_CONCURRENCY=8
LIVE_ORDER_SYNC_CONCURRENCY=8

# Binance LIVE safety flags. Keep both false until the corresponding production
# checklist steps are completed. These are fail-closed gates, not convenience toggles.
ENABLE_LIVE_TRADING=false
# Set true only after a controlled LIVE emergency-exit verification has completed
# successfully and the result has been reviewed by the operator.
BINANCE_LIVE_EMERGENCY_EXIT_VERIFIED=false

# Platform fee deposits: USDT on BNB Smart Chain (BEP20).
# Watch-only account xpub at m/44'/60'/0' from a wallet you control. NEVER put an
# xprv, seed phrase or private key here; the backend refuses private keys.
DEPOSIT_XPUB=
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
BSC_USDT_DECIMALS=18
BSC_CONFIRMATIONS=15
# Optional: block to start scanning from on first run (defaults to the current head).
BSC_SCAN_START_BLOCK=

# Outbound operational notifications. Provider credentials stay server-side.
# Telegram: create a bot with BotFather. The backend captures each user's Chat ID through the secured one-click connection flow.
TELEGRAM_BOT_TOKEN=
# Bot username from BotFather (with or without @). Required for one-click user linking.
TELEGRAM_BOT_USERNAME=
# Public HTTPS endpoint of this backend, ending in /api/notifications/telegram/webhook.
TELEGRAM_WEBHOOK_URL=
# Random A-Z/a-z/0-9/_/- secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# SMTP: used for per-user email notifications. SMTP_FROM should be a verified sender for your provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HBS Trading <notifications@example.com>"

VITE_API_URL=http://localhost:3000/api

# Copy to deploy/.env.production on the server and fill in every value.
# Generate secrets with:  openssl rand -hex 32   (hex keeps them URL-safe)
# NEVER commit deploy/.env.production.

# ---- Domain (point an A record at the server's IP first) ----
DOMAIN=app.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# ---- Database and Redis (only reachable inside Docker) ----
POSTGRES_DB=hbstrading
POSTGRES_USER=hbs
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_24
REDIS_PASSWORD=replace_with_openssl_rand_hex_24

# ---- Secrets ----
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_EXPIRES_IN=1d
# 32-byte key, base64:  openssl rand -base64 32   (losing it makes stored API keys unreadable; back it up offline)
EXCHANGE_CREDENTIALS_KEY=replace_with_openssl_rand_base64_32

# ---- Administrator ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace_with_a_long_admin_step_up_password
# Admins must turn on two-factor authentication in their profile before opening the admin area.
ADMIN_REQUIRE_2FA=true

# ---- Server identity ----
# The VPS public IPv4 address. Shown to users so they restrict their Binance API keys to it.
SERVER_OUTBOUND_IP=203.0.113.10
# Caddy is the only proxy. Set 2 if you put Cloudflare proxying (orange cloud) in front.
TRUST_PROXY_HOPS=1

# ---- Trading ----
ENABLE_LIVE_TRADING=false
BINANCE_LIVE_EMERGENCY_EXIT_VERIFIED=false
BINANCE_HTTP_TIMEOUT_MS=10000
ENTRY_LIMIT_ORDER_TIMEOUT_MS=45000
LIVE_STRATEGY_CONCURRENCY=8
LIVE_ORDER_SYNC_CONCURRENCY=8

# ---- Deposits (USDT BEP20) ----
DEPOSIT_XPUB=
# Use a paid RPC (NodeReal, QuickNode, Ankr...); the public endpoint does not reliably serve eth_getLogs.
BSC_RPC_URL=
BSC_CONFIRMATIONS=15
BSC_SCAN_START_BLOCK=

# ---- Notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=https://app.example.com/api/notifications/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_openssl_rand_hex_32
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HBS Trading <notifications@example.com>"

# ---- Backups (written to the "backups" Docker volume; copy them off the server too) ----
AUTO_BACKUPS_ENABLED=true
